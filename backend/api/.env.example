# Copy to apps/api/.env for local development.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://srms:srms@localhost:5432/srms
# DIRECT_URL=            # Neon only: the non-pooled host, used for migrations

# 32+ random chars:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
# Must be the SAME values as packages/db/.env (they decrypt stored Aadhaar numbers).
AADHAAR_ENC_KEY=
AADHAAR_HASH_PEPPER=

# Demo mode returns OTPs in API responses (no SMS gateway needed). Turn off for real use.
DEMO_MODE=true

# SMS gateway: log (print only) | twilio | fast2sms
SMS_PROVIDER=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# FAST2SMS_API_KEY=

# Only needed if a browser calls the API directly instead of through the apps' /api proxy
# CORS_ORIGINS=http://localhost:3001
