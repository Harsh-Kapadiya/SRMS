{
  "name": "@srms/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SRMS backend: one Express API for the beneficiary, dealer, official and admin apps",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@srms/db": "workspace:*",
    "@srms/shared": "workspace:*",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
