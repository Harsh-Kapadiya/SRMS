{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {},
    "lint": {},
    "test": {
      "cache": false,
      "env": [
        "TEST_DATABASE_URL",
        "DATABASE_URL",
        "AADHAAR_ENC_KEY",
        "AADHAAR_HASH_PEPPER"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
