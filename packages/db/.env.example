# Pooled connection used by the API at runtime (Neon: the "-pooler" host)
DATABASE_URL="postgresql://srms:srms@localhost:5432/srms"
# Direct connection used for migrations (Neon: host without "-pooler")
DIRECT_URL="postgresql://srms:srms@localhost:5432/srms"

# Aadhaar protection (SRS R15 / NFR-4). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AADHAAR_ENC_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"
AADHAAR_HASH_PEPPER="REPLACE_WITH_LONG_RANDOM_STRING"

# First system admin created by `pnpm db:bootstrap` (production)
BOOTSTRAP_ADMIN_EMAIL="admin@srms.gov.in"
BOOTSTRAP_ADMIN_PASSWORD="change-me-to-a-strong-password"
BOOTSTRAP_ADMIN_NAME="System Administrator"
